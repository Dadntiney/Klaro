# Klaro op eigen hosting (Apache, Strato). Beveiligingskoppen, nette adressen en de afscherming van geheime bestanden.
Options -Indexes
# /login is zowel een map als login.html: niet doorsturen naar /login/, maar login.html tonen (zie hieronder).
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Altijd https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # /login -> login.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain
</IfModule>
# De pagina's zelf mogen niet uit de cache van tussenstations komen (altijd de nieuwste versie na een update).
<FilesMatch "(\.html|^overview-worker\.js)$">
  Header set Cache-Control "no-cache"
</FilesMatch>
