# Klaro op eigen hosting (Apache, Strato). Beveiligingskoppen, nette adressen en de afscherming van geheime bestanden.
Options -Indexes
# /login is zowel een map als login.html: niet doorsturen naar /login/, maar login.html tonen (zie hieronder).
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Alleen eigen scripts en de eigen server; favicons van Google; geen insluiten in andere sites.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google.com https://*.gstatic.com; media-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
# Hulpbestanden van de server: alleen voor de andere api-bestanden, niet los op te vragen.
<FilesMatch "^(common|slim)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Altijd https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # De pagina zelf alleen met een geldige sessie (api/gate.php controleert dat en telt het openen als gebruik).
  RewriteRule ^(index\.html)?$ api/gate.php [L]
  # Browsers vragen altijd /favicon.ico: het icoon van de app geven (anders een 404 bij elke opening).
  RewriteRule ^favicon\.ico$ icon.svg [L,T=image/svg+xml]
  # /login -> login.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain
</IfModule>
# De pagina's zelf mogen niet uit de cache van tussenstations komen (altijd de nieuwste versie na een update).
<FilesMatch "(\.html|^overview-worker\.js)$">
  Header set Cache-Control "no-cache"
</FilesMatch>
