# Supabase — Project Settings → API
# The app uses the anon key with the signed-in user. Do not put the service role key in the app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Without a key, Klaro uses a local Dutch reading instead of a model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Used in auth emails. On Vercel the request origin is used when this is empty.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
